# ==============================================================================
# EduTrack Backend Environment Configuration Template
# Copy this file to .env and adjust variables for your local development setup.
# ==============================================================================

# Application Settings
APP_NAME=EduTrack
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1

# Database Connection (PostgreSQL with psycopg v3 driver)
# Format: postgresql+psycopg://<username>:<password>@<host>:<port>/<database_name>
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/edutrack

