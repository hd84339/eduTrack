# ==============================================================================
# EduTrack Frontend Environment Configuration Template
# ==============================================================================

# For Local Development (Vite dev server proxies /api to http://127.0.0.1:8000):
# VITE_API_BASE_URL=/api/v1

# For Production Deployment on Vercel:
# Set this in your Vercel Project Settings -> Environment Variables:
# Replace <your-render-service-name> with your actual Render Web Service name.
# NOTE: Must include https:// and /api/v1, with NO trailing slash!
VITE_API_BASE_URL=https://your-edutrack-api.onrender.com/api/v1
